# Copiar a .env para docker compose. Sin secretos reales en este archivo.

# Superusuario de Postgres: solo lo usa el contenedor db para crear esquemas y roles.
POSTGRES_USER=modivara
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=modivara

# Un rol por dominio, dueño solo de su esquema (infra/postgres/init-schemas.sh).
# docker-compose.yml arma <DOMINIO>_DATABASE_URL (?schema=<dominio>) para la API y Prisma.
CORE_DB_PASSWORD=cambiar-core
HOSPITALITY_DB_PASSWORD=cambiar-hospitality
COMMERCE_DB_PASSWORD=cambiar-commerce
ANALYTICS_DB_PASSWORD=cambiar-analytics

# Broker MQTT: contraseña del usuario `api` (la imprime `scripts/mqtt-user.sh api`). Vacía = la API no se suscribe al broker.
MQTT_PASSWORD=

# Simulador (apps/button-sim): imita un gateway real. No recibe credenciales de la base.
# SIM_GATEWAY_KEY: clave HTTP del gateway de demo (se muestra una vez al crearlo)
SIM_GATEWAY_KEY=cambiar-en-local
# SIM_TRANSPORT: canal inicial: http | mqtt
SIM_TRANSPORT=http
# SIM_GATEWAY_ID: MQTT: usuario del broker = id del gateway
SIM_GATEWAY_ID=
SIM_MQTT_PASSWORD=
# SIM_DEVICES: "btn-01:Mesa 1,btn-02:Mesa 2"; vacío = btn-01…btn-15
SIM_DEVICES=

# Contraseña de todos los usuarios de demo que crea `pnpm seed:core` (obligatoria; 8+ caracteres, mayúscula y número). Solo desarrollo.
# SEED_PASSWORD: solo para `pnpm seed:core` con base propia; nunca en producción
SEED_PASSWORD=CambiarEnLocal1
