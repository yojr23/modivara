# Copiar a .env para docker compose. Sin secretos reales en este archivo.
POSTGRES_USER=modivara
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=modivara

# Un cliente Prisma por dominio, cada uno en su esquema (DATA-001 §1).
CORE_DATABASE_URL=postgresql://modivara:cambiar-en-local@db:5432/modivara?schema=core
HOSPITALITY_DATABASE_URL=postgresql://modivara:cambiar-en-local@db:5432/modivara?schema=hospitality
COMMERCE_DATABASE_URL=postgresql://modivara:cambiar-en-local@db:5432/modivara?schema=commerce
ANALYTICS_DATABASE_URL=postgresql://modivara:cambiar-en-local@db:5432/modivara?schema=analytics

API_PORT=3000
MQTT_URL=mqtt://mqtt:1883

# Simulador (apps/button-sim): imita un gateway real.
SIM_API_URL=http://api:3000/api/v1
SIM_GATEWAY_KEY=cambiar-en-local      # clave HTTP del gateway de demo (se muestra una vez al crearlo)
SIM_TRANSPORT=http                    # canal inicial: http | mqtt
SIM_GATEWAY_ID=                       # MQTT: usuario del broker = id del gateway
SIM_MQTT_PASSWORD=
SIM_DEVICES=                          # "btn-01:Mesa 1,btn-02:Mesa 2"; vacío = btn-01…btn-15
