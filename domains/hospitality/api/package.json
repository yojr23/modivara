{
  "name": "@modivara/hospitality-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:validate": "prisma validate",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@modivara/core-contracts": "workspace:*",
    "@modivara/hospitality-contracts": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/websockets": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie": "1.0.2",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/testing": "12.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
